ESUPL_API_TOKEN=
DVOYKA_BOT_TOKEN=
# Comma-separated personal Telegram IDs. These users can use private chats.
DVOYKA_ALLOWED_USER_IDS=
# Comma-separated group IDs. Every non-anonymous member can use these groups.
DVOYKA_ALLOWED_CHAT_IDS=
# Optional: run once each morning at 08:05 Europe/Minsk. Use - to disable.
DVOYKA_SYNC_CRON="0 5 8 * * *"
