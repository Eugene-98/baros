ESUPL_API_TOKEN=
DVOYKA_BOT_TOKEN=
# Owner Telegram ID, obtained via /id. Staff are then approved in the bot.
DVOYKA_OWNER_USER_IDS=
# Existing IDs are imported as managers; removing an ID here does not revoke access.
DVOYKA_ALLOWED_USER_IDS=
# Optional group IDs. Each member must also have individual access approved by the owner.
DVOYKA_ALLOWED_CHAT_IDS=
# Optional: run once each morning at 08:05 Europe/Minsk. Use - to disable.
DVOYKA_SYNC_CRON="0 5 8 * * *"
