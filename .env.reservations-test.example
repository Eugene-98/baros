# Create a NEW test bot in @BotFather. Never reuse the report or Dvoyka token.
RESERVATION_BOT_TOKEN=
# Start with this empty, send /id to the test bot, then enter your numeric ID.
# While empty the bot only reports IDs; reservation operations are disabled.
RESERVATION_OWNER_USER_IDS=
# Optional private staff group ID. Use /id inside that group to obtain it.
RESERVATION_STAFF_CHAT_ID=0
# Trial settings, not a confirmed weekly opening schedule.
RESERVATION_OPENING_HOUR=18
RESERVATION_CLOSING_HOUR=2
RESERVATION_DURATION_MINUTES=120
RESERVATION_TABLES=12:5,13:3,14:2,15:3
